# .env.example — copy to .env.local and adjust. Vite only exposes vars prefixed VITE_.

# Where the TripWise API lives. Keep "/api": in development Vite forwards it to the backend
# on http://localhost:4000, and in production Cloudflare forwards it to Render.
VITE_API_URL=/api

# Which API answers:
#   true  = the demo API inside the browser (no backend needed; good for design work)
#   false = the real backend (start it with `cd backend && npm run dev`)
VITE_USE_MOCKS=true
