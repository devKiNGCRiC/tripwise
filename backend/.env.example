# .env.example — the settings the TripWise API needs. Copy to `.env` and fill in.
# Never commit the real `.env` (it is git-ignored).

# Port the API listens on locally (Render sets its own).
PORT=4000
# MongoDB Atlas connection string, with the database name "tripwise" after ".mongodb.net/".
MONGO_URI=
# A long random string (at least 32 characters) used to sign login tokens.
JWT_SECRET=
# Where the website runs (allowed to call the API with cookies).
CLIENT_ORIGIN=http://localhost:5173

# AI keys (free tiers). Either may be empty; the other provider is then used alone.
GEMINI_API_KEY=
GROQ_API_KEY=
# Models to try, in order, comma-separated.
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Where the website lives — used in password-reset emails and invite links.
APP_URL=http://localhost:5173

# Optional until set up (see README): Brevo sends password-reset emails (free, 300/day).
# Without these, reset links are printed in the API log instead.
BREVO_API_KEY=
MAIL_FROM=

# Optional until set up: Cloudinary stores journal photos (free plan).
# Without these, photos are kept in MongoDB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
